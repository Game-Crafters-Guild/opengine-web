      "format": "R16G16B16A16_FLOAT",
      "kind": "Texture",
      "scope": "PerView",
      "size": {
        "variables": {}
      },
      "usage": [
        "RenderTarget",
        "ShaderResource"
      ]
    },
    "ScatteringNormalized": {
